# Claude API (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# neatlogs ingest key (Settings -> API Keys). Used by the target agent and by agent-bisect itself.
NEATLOGS_API_KEY=

# neatlogs read access (Settings -> Service Accounts, scopes: observability:read).
# agent-bisect reads traces back through the public API to score each commit.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=

# Ollama Cloud (https://ollama.com/settings/keys): LLM_PROVIDER=ollama_cloud
OLLAMA_API_KEY=

# Optional overrides
# TARGET_MODEL=claude-opus-5-5
# TARGET_EFFORT=low
# FIXER_MODEL=claude-opus-5-5
